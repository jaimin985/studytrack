# ============================================================
# StudyTrack – Environment Configuration
# ============================================================
# Copy this file to .env and edit the values.
#   cp .env.example .env
# NEVER commit .env (it is in .gitignore).
# ============================================================

# ---------- Web App ----------
APP_PORT=8085                       # Host port for the web UI (avoid 5000/7000 on macOS)
SECRET_KEY=change-me-to-a-random-string   # Flask session secret

# ---------- MySQL ----------
MYSQL_HOST=db                       # Docker service name (do NOT change)
MYSQL_PORT=3306                     # Internal container port (do NOT change)
MYSQL_USER=studytrack
MYSQL_PASSWORD=studytrack123
MYSQL_DATABASE=studytrack
MYSQL_ROOT_PASSWORD=rootpass123
DB_HOST_PORT=3307                   # Host port for MySQL (useful for local clients)

# ---------- Email / SMTP ----------
# For Gmail: enable 2FA, then create an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=StudyTrack Reminders

# ---------- Reminder Scheduler ----------
REMINDER_HOUR=8                     # Hour (24h) to run the daily check (default 08:00)
REMINDER_MINUTE=0
REMINDER_CHECK_INTERVAL_MINUTES=    # Set to 1 for demo mode (overrides daily schedule)
